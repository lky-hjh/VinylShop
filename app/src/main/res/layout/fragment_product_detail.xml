<?xml version="1.0" encoding="utf-8"?>
<!--
    Fragment 详情页：使用传统 XML 展示商品详情
    演示 TextView, Button, ImageView, ScrollView 等控件
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".ui.legacy.ProductDetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 大图区 -->
        <ImageView
            android:id="@+id/iv_detail_image"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:scaleType="centerCrop"
            android:background="#1A1A2E" />

        <!-- 唱片名称 -->
        <TextView
            android:id="@+id/tv_detail_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:layout_marginTop="16dp"
            tools:text="Abbey Road" />

        <!-- 艺术家 -->
        <TextView
            android:id="@+id/tv_detail_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp"
            tools:text="The Beatles" />

        <!-- 价格 -->
        <TextView
            android:id="@+id/tv_detail_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#D4A574"
            android:layout_marginTop="12dp"
            tools:text="¥299" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="16dp" />

        <!-- 描述标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="专辑介绍"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <!-- 描述内容 -->
        <TextView
            android:id="@+id/tv_detail_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#555555"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp"
            tools:text="这张专辑是摇滚音乐史上的经典之作..." />

        <!-- 标签区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tv_detail_genre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_tag"
                android:layout_marginEnd="8dp"
                tools:text="摇滚" />

            <TextView
                android:id="@+id/tv_detail_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_tag"
                tools:text="评分: 4.9" />

            <TextView
                android:id="@+id/tv_detail_stock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_tag"
                android:layout_marginStart="8dp"
                tools:text="库存: 50" />

        </LinearLayout>

        <!-- 添加购物车按钮 -->
        <Button
            android:id="@+id/btn_add_to_cart"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="加入购物车"
            android:textSize="16sp"
            android:backgroundTint="#1A1A2E" />

        <!-- Fragment 间数据共享示例 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Fragment 数据共享演示"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tv_shared_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="#888888"
            android:text="从列表 Fragment 传过来的商品 ID 将显示在这里" />

    </LinearLayout>

</ScrollView>
