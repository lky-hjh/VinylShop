<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Activity 生命周期演示 + Fragment 容器
    使用传统 XML 布局文件设计用户界面
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    tools:context=".LegacyDemoActivity">

    <!-- 顶部工具栏：标题 + 生命周期状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#1A1A2E">

        <TextView
            android:id="@+id/tv_lifecycle_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Activity: onCreate"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_fragment_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fragment: -"
            android:textColor="#E0E0E0"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Fragment 容器 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:name="com.example.shoppingapp.ui.legacy.ProductListFragment" />

    <!-- 底部操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <Button
            android:id="@+id/btn_back_to_list"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="返回列表"
            android:enabled="false" />

        <TextView
            android:id="@+id/tv_selection_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="请选择一个唱片"
            android:textSize="14sp"
            android:textColor="#666666"
            android:padding="8dp" />
    </LinearLayout>

</LinearLayout>
